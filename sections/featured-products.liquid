<div class="container py-8 mx-auto">
  <h2 class="mb-4 text-2xl font-bold">{{ section.settings.title }}</h2>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div class="product-image">
      {% if section.settings.product.featured_image %}
        <img
          src="{{ section.settings.product.featured_image | img_url: 'master' }}"
          alt="{{ section.settings.product.title }}"
          class="w-full rounded-lg shadow-md">
      {% endif %}
    </div>
    <div class="product-details">
      <h3 class="text-xl font-semibold">{{ section.settings.product.title }}</h3>
      <p class="text-gray-700">{{ section.settings.product.description | truncatewords: 50 }}</p>
      <p class="text-lg font-bold text-green-500">${{ section.settings.product.price | money_without_currency }}</p>
      <a href="{{ section.settings.product.url }}" class="inline-block px-4 py-2 font-bold text-white bg-blue-500 rounded hover:bg-blue-700">View Product</a>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Featured Product",
    "settings": [
      {
        "id": "title",
        "type": "text",
        "label": "Section Title",
        "default": "Featured Product"
      }, {
        "id": "product",
        "type": "product",
        "label": "Product"
      }
    ],
    "presets": [
      {
        "name": "Featured Product",
        "category": "Product"
      }
    ]
  }
{% endschema %}